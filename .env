# PostgreSQL
DATABASE_URL=postgres://gaocheng@localhost/quant

# Server — 本地开发端口 8081（生产 ~/.env.quant 用 8080）
PORT=8081

RUST_LOG=quant=info,quant_api=info

# DingTalk Bot (消息机器人)
DINGTALK_CLIENT_ID=14ffbd070b58dca1770f2f629eabd8b74237792a597b8bbc6420f20a8abd3fab

# 任务80 C类可配项（默认值见代码，未配置时行为与原写死值完全一致）
# DINGTALK_ALERT_TIMEOUT_SECS        — 钉钉告警 HTTP 总超时(秒)
# DINGTALK_ALERT_CONNECT_TIMEOUT_SECS — 钉钉告警连接超时(秒)
# TUSHARE_MAX_RETRIES                — Tushare 客户端最大重试次数
# TUSHARE_RETRY_DELAY_MS             — Tushare 重试基础延迟(毫秒)
# TUSHARE_SYNC_CHUNK                 — 日线同步单批股票数
# TUSHARE_PAGE_LIMIT                 — 日线同步单页行数
# FINANCE_QUARTER_BATCH_DAYS         — 财务/资金流接口季度分批窗口(天)
# PG_COPY_BATCH_ROWS                 — PG 落库大批分批行数(daily_basic)
# PG_UPSERT_BATCH_ROWS               — PG 常规 upsert 分批行数
# ML_PREDICTION_INSERT_BATCH         — model_prediction 插入分批行数
# NATIVE_PV_BATCH_SYMBOLS            — 原生量价因子夜间增量单批股票数
# FACTOR_VERSION                     — factor_value.factor_version 统一口径
# DATA_PROBE_SYMBOLS                 — 盘前数据探针(逗号分隔)
# MARKET_CALENDAR_EXCHANGE           — 交易日历交易所(market_trade_calendar.exchange)
# LOT_SIZE                           — A股最小交易单位(1手股数)
# ANNUALIZATION_DAYS                 — 年化交易日基数(Sharpe/年化波动)

